def calculate_all_metrics(model, X_test, y_test):
    """计算模型在测试集上的12个评估指标。"""
    y_pred = model.predict(X_test)
    y_proba = model.predict_proba(X_test)[:, 1]
    
    tn, fp, fn, tp = confusion_matrix(y_test, y_pred).ravel()
    
    metrics = {
        "精确率": precision_score(y_test, y_pred, zero_division=0),
        "召回率": recall_score(y_test, y_pred, zero_division=0),
        "F2分数": fbeta_score(y_test, y_pred, beta=2, zero_division=0),
        "AUC-PR": average_precision_score(y_test, y_proba),
        "AUC-ROC": roc_auc_score(y_test, y_proba),
        "马修斯相关系数": matthews_corrcoef(y_test, y_pred),
        "科恩卡帕系数": cohen_kappa_score(y_test, y_pred),
        "平衡准确率": balanced_accuracy_score(y_test, y_pred),
        "几何均值": np.sqrt(recall_score(y_test, y_pred, zero_division=0) * (tn/(tn+fp) if (tn+fp)>0 else 0)),
        "阴性预测值": tn/(tn+fn) if (tn+fn)>0 else 0,
        "特异性": tn/(tn+fp) if (tn+fp)>0 else 0,
        "诊断优势比": (tp*tn)/(fp*fn) if (fp*fn)>0 else np.nan,
    }
    return metrics, y_proba

def tune_xgboost_efficiently(file_paths, output_dir=None, n_iter=50):
    print("="*60)
    print("开始心理危机预测 - XGBoost调参")
    print(f"优化目标：召回率 | 随机搜索迭代次数：{n_iter}")
    print("="*60)
    start_time = time.time()
    
    # 1. 设置输出目录
    if output_dir is None:
        desktop = os.path.join(os.path.expanduser("~"), "Desktop")
        output_dir = os.path.join(desktop, "XGBoost高效调参")
    os.makedirs(output_dir, exist_ok=True)
    print(f"结果将保存至: {output_dir}")
    
    # 2. 数据预处理
    print("\n=== 步骤1: 数据预处理与划分 ===")
    
    all_dfs = []
    for fp in file_paths:
        if os.path.exists(fp):
            df = pd.read_excel(fp, sheet_name=None)
            for sheet in ["严重心理危机", "一般心理问题", "潜在心理困扰", "无心理困扰"]:
                if sheet in df:
                    all_dfs.append(df[sheet])
        else:
            print(f"警告: 文件不存在，已跳过 -> {fp}")
    
    if not all_dfs:
        print("错误: 未找到任何有效数据文件，流程终止。")
        return
    
    merged_df = pd.concat(all_dfs, ignore_index=True)
    print(f"合并后总数据量: {merged_df.shape}")
    
    # 清洗数据: 保留一致性得分 >= 2
    cleaned_df = merged_df[merged_df['一致性得分'] >= 2].copy()
    print(f"清洗后(一致性得分>=2)数据量: {cleaned_df.shape}")
    
    # 创建目标变量
    cleaned_df["有自杀意图"] = cleaned_df["可能问题"].apply(lambda x: 1 if "自杀意图" in str(x) else 0)
    print(f"目标变量分布 - 有自杀意图: {cleaned_df['有自杀意图'].sum()}, 无: {len(cleaned_df)-cleaned_df['有自杀意图'].sum()}")
    
    # 跳过指定列
    skip_cols = ['学历层次', '入学年份', '出生日期', '总分', '家庭关系满意度',
                 '学校及专业满意度', '可能问题', '测评等级', '提交时间',
                 '一致性得分', '总用时(秒)', '自杀意图(指标标准分)']
    skip_cols.extend([col for col in cleaned_df.columns if "(指标总分)" in col])
    
    # 对分类变量进行独热编码
    cat_cols = ["性别", "民族", "生源地", "是否独生"]
    encoder = OneHotEncoder(drop='first', sparse_output=False, handle_unknown='ignore')
    encoded_features = encoder.fit_transform(cleaned_df[cat_cols])
    feature_names_cat = encoder.get_feature_names_out(cat_cols)
    encoded_df = pd.DataFrame(encoded_features, columns=feature_names_cat)
    
    # 移除代表NaN的编码列
    columns_to_drop = [col for col in encoded_df.columns if col.endswith("_nan")]
    if columns_to_drop:
        encoded_df = encoded_df.drop(columns=columns_to_drop)
        feature_names_cat = [col for col in feature_names_cat if col not in columns_to_drop]
    
    # 构建数值特征列
    num_cols_for_model = [col for col in cleaned_df.columns 
                          if col not in skip_cols + cat_cols + ["有自杀意图", "自杀意图(指标标准分)"]]
    
    # 合并最终特征
    X = pd.concat([cleaned_df[num_cols_for_model].reset_index(drop=True), 
                   encoded_df.reset_index(drop=True)], axis=1)
    y = cleaned_df["有自杀意图"].values
    
    print(f"最终特征维度: {X.shape[1]} 个特征")
    print(f"数值特征数量: {len(num_cols_for_model)}, 分类特征数量: {len(feature_names_cat)}")
    
    # 记录分类特征索引，供SMOTE-ENC使用
    categorical_indices = [i for i, col in enumerate(X.columns) if col in feature_names_cat]
    print(f"分类特征在特征矩阵中的索引: {categorical_indices[:5]}...")
    
    # 分层划分训练集和测试集 (7:3)
    X_train, X_test, y_train, y_test = train_test_split(
        X, y, test_size=0.3, random_state=42, stratify=y
    )
    print(f"训练集: {X_train.shape[0]} 样本, 测试集: {X_test.shape[0]} 样本")
    print(f"训练集中正类(有自杀意图)比例: {y_train.mean():.2%}")
    
    print(f"\n数据预处理完成，耗时: {time.time()-start_time:.1f}秒")
    
    # 3. 构建Pipeline
    print("\n=== 步骤2: 构建建模 Pipeline ===")
    
    preprocessor = ColumnTransformer(
        transformers=[
            ('num', StandardScaler(), num_cols_for_model),
            ("cat", "passthrough", feature_names_cat)
        ]
    )
    
    # 创建基础XGBoost模型
    base_xgb = xgb.XGBClassifier(
        random_state=42,
        use_label_encoder=False,
        eval_metric='logloss',
        n_jobs=-1
    )
    
    # 完整Pipeline
    pipe_xgb = Pipeline([
        ('preprocessor', preprocessor),
        ('smote', SMOTENC(categorical_features=categorical_indices, random_state=42, sampling_strategy='auto')),
        ('model', base_xgb)
    ])
    
    print("√ Pipeline构建完成")
    
    # 4. 第一阶段：随机搜索调整树结构参数
    print("\n=== 步骤3: 第一阶段 - 随机搜索调整树结构参数 ===")
    print("调整参数: max_depth, min_child_weight, gamma, subsample, colsample_bytree")
    
    # 定义第一阶段的参数分布
    param_dist_stage1 = {
        'model__max_depth': stats.randint(3, 10),  # 3-9之间的整数
        'model__min_child_weight': stats.randint(1, 10),  # 1-9之间的整数
        'model__gamma': stats.uniform(0, 0.5),  # 0-0.5之间的均匀分布
        'model__subsample': stats.uniform(0.6, 0.4),  # 0.6-1.0之间的均匀分布
        'model__colsample_bytree': stats.uniform(0.6, 0.4),  # 0.6-1.0之间的均匀分布
    }
    
    # 固定其他参数
    fixed_params_stage1 = {
        'model__n_estimators': 200,
        'model__learning_rate': 0.1,
        'model__reg_alpha': 0,
        'model__reg_lambda': 1,
    }
    
    # 设置固定参数
    for param, value in fixed_params_stage1.items():
        pipe_xgb.set_params(**{param: value})
    
    # 使用随机搜索
    cv_strategy = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)
    
    random_search_stage1 = RandomizedSearchCV(
        estimator=pipe_xgb,
        param_distributions=param_dist_stage1,
        n_iter=n_iter,  # 随机搜索的迭代次数
        scoring='recall',
        cv=cv_strategy,
        verbose=1,
        n_jobs=-1,
        random_state=42
    )
    
    print(f"开始第一阶段随机搜索（{n_iter}次迭代）...")
    stage1_start = time.time()
    random_search_stage1.fit(X_train, y_train)
    stage1_time = time.time() - stage1_start
    
    print(f"第一阶段完成，耗时: {stage1_time:.1f}秒")
    print(f"最佳参数: {random_search_stage1.best_params_}")
    print(f"最佳交叉验证召回率: {random_search_stage1.best_score_:.4f}")
    
    # 5. 第二阶段：调整正则化参数和学习率
    print("\n=== 步骤4: 第二阶段 - 调整正则化参数和学习率 ===")
    print("调整参数: reg_alpha, reg_lambda, learning_rate, n_estimators")
    
    # 获取第一阶段的最佳参数
    best_params_stage1 = random_search_stage1.best_params_
    
    # 设置第二阶段的参数分布
    param_dist_stage2 = {
        'model__reg_alpha': stats.uniform(0, 2),  # 0-2之间的均匀分布
        'model__reg_lambda': stats.uniform(0.1, 5),  # 0.1-5.1之间的均匀分布
        'model__learning_rate': stats.uniform(0.01, 0.3),  # 0.01-0.31之间的均匀分布
        'model__n_estimators': stats.randint(100, 500),  # 100-499之间的整数
    }
    
    # 使用第一阶段的模型作为基础
    pipe_stage2 = random_search_stage1.best_estimator_
    
    # 创建第二阶段随机搜索
    random_search_stage2 = RandomizedSearchCV(
        estimator=pipe_stage2,
        param_distributions=param_dist_stage2,
        n_iter=n_iter//2,  # 第二阶段的迭代次数减半
        scoring='recall',
        cv=cv_strategy,
        verbose=1,
        n_jobs=-1,
        random_state=42
    )
    
    print(f"开始第二阶段随机搜索（{n_iter//2}次迭代）...")
    stage2_start = time.time()
    random_search_stage2.fit(X_train, y_train)
    stage2_time = time.time() - stage2_start
    
    print(f"第二阶段完成，耗时: {stage2_time:.2f}秒")
    
    # 合并两阶段的最佳参数
    final_best_params = {**best_params_stage1, **random_search_stage2.best_params_}
    print(f"\n最终最佳参数组合: {final_best_params}")
    print(f"最终交叉验证召回率: {random_search_stage2.best_score_:.4f}")
    
    # 获取最终最佳模型
    best_xgb_model = random_search_stage2.best_estimator_
    
    # 6. 在测试集上评估最终模型
    print("\n=== 步骤5: 在独立测试集上评估最终XGBoost模型 ===")
    test_metrics, y_proba = calculate_all_metrics(best_xgb_model, X_test, y_test)
    
    # 打印所有评估指标
    print("\nXGBoost模型在测试集上的性能指标:")
    print("-" * 50)
    for metric_name, value in test_metrics.items():
        print(f"{metric_name:20s}: {value:.4f}")
    print("-" * 50)
    
    # 7. 保存结果
    print("\n=== 步骤6: 保存结果 ===")
    
    # 保存评估结果
    results_df = pd.DataFrame([test_metrics])
    results_df['最佳参数'] = str(final_best_params)
    results_df["调参方法"] = "两阶段随机搜索"
    results_df["总耗时(秒)"] = time.time() - start_time
    results_df["第一阶段耗时"] = stage1_time
    results_df["第二阶段耗时"] = stage2_time
    
    results_excel_path = os.path.join(output_dir, "XGBoost模型_高效调参结果.xlsx")
    results_df.to_excel(results_excel_path, index=False)
    print(f"评估指标已保存至: {results_excel_path}")
    
    # 保存详细的参数搜索记录
    search_results = []
    for i, params in enumerate(random_search_stage1.cv_results_['params']):
        search_results.append({
            '阶段': '第一阶段',
            '迭代': i+1,
            '参数': str(params),
            '召回率': random_search_stage1.cv_results_['mean_test_score'][i],
            '标准差': random_search_stage1.cv_results_['std_test_score'][i]
        })
    
    for i, params in enumerate(random_search_stage2.cv_results_['params']):
        search_results.append({
            '阶段': '第二阶段',
            '迭代': i+1,
            '参数': str(params),
            '召回率': random_search_stage2.cv_results_['mean_test_score'][i],
            '标准差': random_search_stage2.cv_results_['std_test_score'][i]
        })
    
    search_df = pd.DataFrame(search_results)
    search_path = os.path.join(output_dir, "随机搜索详细记录.xlsx")
    search_df.to_excel(search_path, index=False)
    print(f"详细搜索记录已保存至: {search_path}")
    
    print(f"\n总耗时: {time.time()-start_time:.1f}秒")
    print("="*60)
    print("高效调参流程完成！")
    print("="*60)
    
    return best_xgb_model, test_metrics, final_best_params

